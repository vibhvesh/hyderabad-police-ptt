# Optional. The demo runs with none of these set.
PORT=43124
HOST=0.0.0.0

# te -> indic-conformer, en/hi -> google. Any language can be set to elevenlabs.
STT_PROVIDER_TE=indic-conformer
STT_PROVIDER_EN=google
STT_PROVIDER_HI=google

GOOGLE_SPEECH_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2

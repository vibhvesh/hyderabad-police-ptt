# Copy to .env on the server. Do not commit real tokens.
# The browser never receives these values. Operators type tokens into the Reference page.

HOST=0.0.0.0
PORT=8080

# Required before the matching action works. Empty means that action returns "not configured".
ADMIN_TOKEN=
REVIEWER_TOKEN=
INGEST_TOKEN=
WEBHOOK_SECRET=
WEBHOOK_TOKEN=

DATA_DIR=./data
STATIC_DIR=
CORS_ORIGINS=*
KB_MAX_BYTES=262144
AUDIO_MAX_BYTES=5000000

# none | transformers | whisper-cli | mock
# transformers downloads onnx-community/whisper-tiny into MODEL_DIR on first use.
# mock does nothing unless ALLOW_MOCK_PROVIDERS=1, and even then it only echoes an explicit test header.
ASR_PROVIDER=none
ASR_MODEL=onnx-community/whisper-tiny
WHISPER_CLI=whisper-cli
MODEL_DIR=./data/models
ALLOW_MOCK_PROVIDERS=

# none | opus | libre | mymemory
# opus is local English, Hindi, and Telugu (Xenova OPUS models, also stored in MODEL_DIR).
# mymemory is a public remote service. Do not send sensitive text.
TRANSLATE_PROVIDER=none
TRANSLATE_MODEL_EN_HI=Xenova/opus-mt-en-hi
TRANSLATE_MODEL_HI_EN=Xenova/opus-mt-hi-en
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# none | espeak | mock
TTS_PROVIDER=none
ESPEAK_BIN=espeak-ng

# Optional bearer sent to admin-configured fetch sources. Not a mailbox password.
SOURCE_FETCH_BEARER=

# ALSA device names. Leave empty on a machine with no local radio audio.
AUDIO_INPUT=
AUDIO_OUTPUT=
PI_PROFILE=

TLS_CERT=
TLS_KEY=

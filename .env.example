# Copy to .env on the server. Do not commit real tokens.
# The browser never receives these values. Operators type tokens into the Reference page.

HOST=0.0.0.0
PORT=8080

# Required before the matching action works. Empty means that action returns "not configured".
ADMIN_TOKEN=
REVIEWER_TOKEN=
INGEST_TOKEN=
WEBHOOK_SECRET=
WEBHOOK_TOKEN=

DATA_DIR=./data
STATIC_DIR=
CORS_ORIGINS=*
KB_MAX_BYTES=262144
AUDIO_MAX_BYTES=5000000

# none | whisper-cli | mock
# mock does nothing unless ALLOW_MOCK_PROVIDERS=1, and even then it only echoes an explicit test header.
ASR_PROVIDER=none
ASR_MODEL=tiny
WHISPER_CLI=whisper-cli
ALLOW_MOCK_PROVIDERS=

# none | libre | mymemory
# mymemory is a public remote service. Do not send sensitive text.
TRANSLATE_PROVIDER=none
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# none | espeak | mock
TTS_PROVIDER=none
ESPEAK_BIN=espeak-ng

# Optional bearer sent to admin-configured fetch sources. Not a mailbox password.
SOURCE_FETCH_BEARER=

# ALSA device names. Leave empty on a machine with no local radio audio.
AUDIO_INPUT=
AUDIO_OUTPUT=
PI_PROFILE=

TLS_CERT=
TLS_KEY=

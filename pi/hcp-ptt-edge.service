[Unit]
Description=Hyderabad Police PTT edge button and headset
After=network-online.target sound.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=hcp-ptt
Group=hcp-ptt
SupplementaryGroups=audio gpio
WorkingDirectory=/opt/hcp-ptt
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/hcp-ptt.env
ExecStart=/usr/bin/python3 /opt/hcp-ptt/pi/ptt_edge.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
